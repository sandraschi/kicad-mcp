{
  "manifest_version": "0.2",
  "name": "kicad-mcp",
  "version": "0.3.0",
  "description": "KiCad MCP server - PCB/schematic design automation via MCP tools and REST API",
  "author": { "name": "sandraschi" },
  "server": {
    "type": "python",
    "entry_point": "run_server.py",
    "mcp_config": {
      "command": "uv",
      "args": ["run","--directory","${PWD}","run_server.py"],
      "env": {
        "PYTHONPATH": "${PWD}/src",
        "PYTHONUNBUFFERED": "1"
      }
    }
  },
  "tools": [
    { "name": "fab_export", "description": "Zip Gerber outputs for fabrication." },
    { "name": "fab_order", "description": "Create a fabrication order record." },
    { "name": "fab_list_orders", "description": "List fabrication order history." },
    { "name": "fab_get_order", "description": "fab_get_order" },
    { "name": "review_create", "description": "review_create" },
    { "name": "review_list", "description": "review_list" },
    { "name": "review_get", "description": "review_get" },
    { "name": "review_annotate", "description": "review_annotate" },
    { "name": "review_ai_audit", "description": "review_ai_audit" },
    { "name": "kicad_status", "description": "kicad_status" },
    { "name": "kicad_supported_commands", "description": "kicad_supported_commands" },
    { "name": "api_status", "description": "api_status" },
    { "name": "api_health", "description": "api_health" },
    { "name": "api_diagnostics", "description": "api_diagnostics" },
    { "name": "api_list_tools", "description": "api_list_tools" },
    { "name": "api_list_skills", "description": "api_list_skills" },
    { "name": "api_get_skill", "description": "api_get_skill" },
    { "name": "api_llm_discover", "description": "Probe Ollama and LM Studio, return detected providers + models." },
    { "name": "api_llm_chat", "description": "Proxy chat completion to local LLM (Ollama or OpenAI-compatible)." },
    { "name": "api_control_tool", "description": "Dispatch REST calls to registered MCP tools by name." },
    { "name": "api_upload", "description": "Upload a KiCad project file (PCB, schematic, etc.)." },
    { "name": "api_list_files", "description": "List files in uploads or outputs directory." },
    { "name": "api_download", "description": "Download a generated file from outputs or uploads." },
    { "name": "api_boards_search", "description": "Search GitHub for KiCad board projects." },
    { "name": "api_component_detail", "description": "Return mock component details for a part number or query." },
    { "name": "api_board_preview", "description": "api_board_preview" },
    { "name": "bom_generate", "description": "bom_generate" },
    { "name": "lib_list_footprints", "description": "lib_list_footprints" },
    { "name": "lib_list_symbols", "description": "lib_list_symbols" },
    { "name": "lib_find_footprint", "description": "lib_find_footprint" },
    { "name": "lib_find_symbol", "description": "lib_find_symbol" },
    { "name": "fp_export_svg", "description": "fp_export_svg" },
    { "name": "sym_export_svg", "description": "sym_export_svg" },
    { "name": "marketplace_search", "description": "marketplace_search" },
    { "name": "marketplace_categories", "description": "marketplace_categories" },
    { "name": "marketplace_download", "description": "marketplace_download" },
    { "name": "parts_search", "description": "parts_search" },
    { "name": "parts_missing", "description": "parts_missing" },
    { "name": "boards_search", "description": "boards_search" },
    { "name": "boards_download", "description": "boards_download" },
    { "name": "pcb_load", "description": "pcb_load" },
    { "name": "pcb_info", "description": "pcb_info" },
    { "name": "pcb_list_components", "description": "pcb_list_components" },
    { "name": "pcb_list_nets", "description": "pcb_list_nets" },
    { "name": "pcb_list_tracks", "description": "pcb_list_tracks" },
    { "name": "pcb_get_component", "description": "pcb_get_component" },
    { "name": "pcb_drc", "description": "pcb_drc" },
    { "name": "pcb_export_step", "description": "pcb_export_step" },
    { "name": "pcb_export_gerber", "description": "pcb_export_gerber" },
    { "name": "pcb_export_pos", "description": "pcb_export_pos" },
    { "name": "pcb_export_dxf", "description": "pcb_export_dxf" },
    { "name": "pcb_export_svg", "description": "pcb_export_svg" },
    { "name": "pcb_export_pdf", "description": "pcb_export_pdf" },
    { "name": "pcb_export_vrml", "description": "pcb_export_vrml" },
    { "name": "pcb_export_glb", "description": "pcb_export_glb" },
    { "name": "pcb_export_ipc2581", "description": "pcb_export_ipc2581" },
    { "name": "pcb_export_odbpp", "description": "pcb_export_odbpp" },
    { "name": "pcb_place_component", "description": "pcb_place_component" },
    { "name": "pcb_add_track", "description": "pcb_add_track" },
    { "name": "pcb_add_via", "description": "pcb_add_via" },
    { "name": "pcb_save", "description": "pcb_save" },
    { "name": "pcb_set_board_outline", "description": "pcb_set_board_outline" },
    { "name": "sch_load", "description": "sch_load" },
    { "name": "sch_info", "description": "sch_info" },
    { "name": "sch_erc", "description": "sch_erc" },
    { "name": "sch_export_netlist", "description": "sch_export_netlist" },
    { "name": "sch_export_python_bom", "description": "sch_export_python_bom" },
    { "name": "sch_export_pdf", "description": "sch_export_pdf" },
    { "name": "sch_export_svg", "description": "sch_export_svg" },
    { "name": "sch_export_dxf", "description": "sch_export_dxf" }
  ]
}
