# KiCad MCP Configuration
# Copy this file to .env and fill in your values.

# KiCad CLI paths (auto-detected if not set)
# KICAD_CLI_PATH=C:\Program Files\KiCad\10.0\bin\kicad-cli.exe
# KICAD_IPC_CLI_PATH=C:\Program Files\KiCad\11.0-nightly\bin\kicad-cli.exe

# CRUD backend preference: ipc | tcp | none (auto if not set)
# KICAD_CRUD_BACKEND=ipc

# Legacy TCP bridge port (default 11018)
# KC_BRIDGE_PORT=11018

# Working directory for uploads and outputs
# KICAD_MCP_WORK_DIR=%TEMP%\kicad_mcp_work
