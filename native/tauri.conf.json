{
  "productName": "KiCad MCP",
  "version": "0.1.0",
  "identifier": "ai.fleet.kicad-mcp",
  "build": {
    "frontendDist": "../webapp/dist",
    "devUrl": "http://localhost:11017",
    "beforeDevCommand": "npm --prefix ../webapp run dev"
  },
  "app": {
    "windows": [{
      "title": "KiCad MCP",
      "width": 1200, "height": 800,
      "minWidth": 700, "minHeight": 500
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/{name}-backend"]
  },
  "plugins": {
    "shell": { "open": true },
    "fs": { "requireLiteralLeadingDot": false },
    "process": { "all": true }
  }
}
