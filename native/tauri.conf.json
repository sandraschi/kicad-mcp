{
  "productName": "KiCad MCP",
  "version": "0.3.0",
  "identifier": "ai.fleet.kicad-mcp",
  "build": {
    "frontendDist": "../webapp/dist",
    "devUrl": "http://localhost:11017",
    "beforeDevCommand": "npm --prefix ../webapp run dev"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "KiCad MCP",
      "width": 1200, "height": 800,
      "minWidth": 700, "minHeight": 500
    }],
    "security": { "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:11016 ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": ["resources/kicad-mcp-backend.exe",
            "resources/.env.example"],
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
}
    }
  },
  "plugins": {
    "shell": { "open": true },
    "fs": { "requireLiteralLeadingDot": false },
    "process": { "all": true }
  }
}



